{
  "name": "wscdc-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API interna para WSAA/WSCDC.",
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:prod": "cross-env ARCA_ENV=produccion NODE_ENV=production node --watch src/server.js",
    "dev:prod:legacy-tls": "cross-env ARCA_ENV=produccion NODE_ENV=production NODE_OPTIONS=--tls-cipher-list=DEFAULT@SECLEVEL=1 node --watch src/server.js",
    "dev:homo": "cross-env ARCA_ENV=homologacion NODE_ENV=development node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.2",
    "helmet": "^8.0.0",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nock": "^13.5.6",
    "supertest": "^7.0.0",
    "vitest": "^4.1.5"
  }
}
