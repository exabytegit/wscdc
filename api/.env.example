# Entorno local de la API WSCDC. No incluir secretos reales en este archivo.
NODE_ENV=development
PORT=3002
API_BASE_PATH=/api

ARCA_ENV=homologacion
ARCA_SERVICE=wscdc
ARCA_CUIT=

ARCA_WSAA_HOMO_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSAA_PROD_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms

ARCA_WSCDC_HOMO_URL=https://wswhomo.afip.gob.ar/WSCDC/service.asmx
ARCA_WSCDC_PROD_URL=https://servicios1.afip.gov.ar/WSCDC/service.asmx
ARCA_WSCDC_NAMESPACE=http://servicios1.afip.gob.ar/wscdc/

ARCA_CERT_PATH=
ARCA_KEY_PATH=
OPENSSL_BIN=C:\Program Files\OpenSSL-Win64\bin\openssl.exe
TA_CACHE_DIR=tmp
TA_RENEW_SKEW_SECONDS=600
REQUEST_TIMEOUT_MS=60000
CORS_ORIGIN=http://127.0.0.1:5500,http://127.0.0.1:5501
LOG_LEVEL=info

# Produccion debe configurarse fuera del repo. No crear credenciales reales aqui.
