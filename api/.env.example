# Entorno local de la API. No incluir secretos reales en este archivo.
NODE_ENV=development
PORT=3001
API_BASE_PATH=/api

ARCA_ENV=homologacion
ARCA_SERVICE=wsapoc
ARCA_CUIT_DELEGADO=

WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
WSAPOC_URL=https://eapoc-ws-qaext.afip.gob.ar/Service.asmx
WSAPOC_NAMESPACE=http://tempuri.org/

# Referencias por ambiente para preparar homologacion/produccion.
# La API actual usa WSAA_URL y WSAPOC_URL como variables efectivas.
ARCA_WSAA_HOMO_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSAA_PROD_URL=https://wsaa.afip.gov.ar/ws/services/LoginCms
ARCA_WSAPOC_HOMO_URL=https://eapoc-ws-qaext.afip.gob.ar/Service.asmx
ARCA_WSAPOC_PROD_URL=https://eapoc-ws.afip.gob.ar/service.asmx

ARCA_CERT_PATH=
ARCA_KEY_PATH=
OPENSSL_BIN=C:\Program Files\OpenSSL-Win64\bin\openssl.exe
TA_CACHE_DIR=C:\EXAPP\api\tmp
TA_RENEW_SKEW_SECONDS=600
REQUEST_TIMEOUT_MS=60000
LOG_LEVEL=info

# Plantilla sugerida para preparar despliegues.
# No completar con secretos reales dentro del repositorio.
# ARCA_ENV=homologacion|produccion
# ARCA_SERVICE=wsapoc
# ARCA_CUIT_DELEGADO=
# ARCA_WSAA_HOMO_URL=
# ARCA_WSAA_PROD_URL=
# ARCA_WSAPOC_HOMO_URL=
# ARCA_WSAPOC_PROD_URL=
# ARCA_CERT_PATH=
# ARCA_KEY_PATH=
# OPENSSL_BIN=
# TA_CACHE_DIR=
